{
  "name": "cue",
  "productName": "Cue",
  "version": "1.0.0",
  "description": "Personal real-time call assistant for Windows and macOS (Work and Interview modes)",
  "author": "Omkar",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "icon": "node scripts/make-icon.mjs",
    "mock-teams": "node scripts/mock-teams.mjs"
  },
  "build": {
    "appId": "com.omkar.cue",
    "productName": "Cue",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "config/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cue transcribes your microphone for the \"Me\" transcript, voice questions and Practice.",
        "NSAudioCaptureUsageDescription": "Cue transcribes call audio from other apps to answer questions."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cue",
      "uninstallDisplayName": "Cue",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Cue-Setup-${version}.exe"
    },
    "dmg": {
      "artifactName": "Cue-${version}-${arch}.dmg"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
