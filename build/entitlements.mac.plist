<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Ad-hoc ("-") signed builds: Electron's frameworks carry a different signature. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone ("Me" lane, voice questions, Practice). System audio and screenshots need no
         entitlement: they go through Screen & System Audio Recording, granted in System Settings. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
